<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Diagnóstico AI Readiness — Sesión 1</title>
  <style>
    /* Color palette: primary #1E2A44, accent #E8A33D, alert #B23A48 */
    :root {
      --color-primary: #1E2A44;
      --color-accent: #E8A33D;
      --color-alert: #B23A48;
      --color-text: #333333;
      --color-bg-light: #F8F9FB;
    }

    @page {
      margin: 2cm 2.5cm;
      @bottom-center {
        content: "Página " counter(page) " de " counter(pages);
        font-size: 10px;
        color: #888;
      }
    }

    body {
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-size: 11pt;
      color: var(--color-text);
      line-height: 1.5;
    }

    /* ── Portada ─────────────────────────────────────────────────────────── */
    .portada {
      text-align: center;
      padding: 4cm 0 3cm;
      page-break-after: always;
      background-color: var(--color-primary);
      color: white;
      margin: -2cm -2.5cm 0;
      padding: 4cm 2.5cm 3cm;
    }

    .portada .logo {
      max-height: 80px;
      margin-bottom: 2cm;
    }

    .portada h1 {
      font-size: 24pt;
      font-weight: 700;
      margin: 0 0 0.5cm;
      letter-spacing: -0.02em;
    }

    .portada .company-name {
      font-size: 18pt;
      font-weight: 400;
      color: var(--color-accent);
      margin: 0 0 0.3cm;
    }

    .portada .fecha {
      font-size: 11pt;
      opacity: 0.7;
      margin: 0;
    }

    /* ── Secciones ────────────────────────────────────────────────────────── */
    .seccion {
      margin-bottom: 1.5cm;
    }

    h2 {
      font-size: 16pt;
      font-weight: 700;
      color: var(--color-primary);
      border-bottom: 3px solid var(--color-accent);
      padding-bottom: 0.3cm;
      margin-top: 1cm;
      margin-bottom: 0.5cm;
    }

    h3 {
      font-size: 13pt;
      font-weight: 600;
      color: var(--color-primary);
      margin: 0.8cm 0 0.3cm;
    }

    p {
      margin: 0 0 0.5cm;
    }

    ul, ol {
      margin: 0 0 0.5cm 1.2cm;
      padding: 0;
    }

    li {
      margin-bottom: 0.3cm;
    }

    /* ── Tarjetas de recomendación ────────────────────────────────────────── */
    .rec-card {
      background: var(--color-bg-light);
      border-left: 4px solid var(--color-accent);
      padding: 0.5cm 0.7cm;
      margin-bottom: 0.6cm;
      border-radius: 3px;
    }

    .rec-card .rec-text {
      font-size: 11pt;
      font-weight: 500;
      margin: 0 0 0.3cm;
    }

    .rec-badges {
      display: flex;
      gap: 0.4cm;
      flex-wrap: wrap;
    }

    .badge {
      font-size: 9pt;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 3px;
      display: inline-block;
    }

    .badge-impacto-alto  { background: #D32F2F; color: white; }
    .badge-impacto-medio { background: #F57C00; color: white; }
    .badge-impacto-bajo  { background: #388E3C; color: white; }
    .badge-esfuerzo-alto  { background: #C62828; color: white; opacity: 0.85; }
    .badge-esfuerzo-medio { background: #EF6C00; color: white; opacity: 0.85; }
    .badge-esfuerzo-bajo  { background: #2E7D32; color: white; opacity: 0.85; }
    .badge-servicio { background: var(--color-primary); color: white; }

    /* ── Roadmap ─────────────────────────────────────────────────────────── */
    .roadmap-grid {
      display: table;
      width: 100%;
      border-collapse: collapse;
    }

    .roadmap-col {
      display: table-cell;
      width: 33%;
      vertical-align: top;
      padding: 0.3cm 0.5cm;
      border: 1px solid #DDD;
    }

    .roadmap-col h3 {
      font-size: 11pt;
      font-weight: 700;
      color: var(--color-accent);
      margin: 0 0 0.4cm;
      text-align: center;
      background: var(--color-primary);
      padding: 0.2cm;
      border-radius: 2px;
    }

    /* ── Catálogo de servicios (footer section) ────────────────────────────── */
    .catalogo {
      margin-top: 1.5cm;
      border-top: 2px solid var(--color-primary);
      padding-top: 0.5cm;
    }

    .catalogo h2 {
      font-size: 14pt;
    }

    .servicio-item {
      margin-bottom: 0.8cm;
    }

    .servicio-nombre {
      font-weight: 700;
      color: var(--color-primary);
      font-size: 11pt;
    }

    .servicio-desc {
      font-size: 10pt;
      color: #555;
      margin-top: 0.1cm;
    }

    /* ── Utilidades ──────────────────────────────────────────────────────── */
    .placeholder-text {
      color: #AAA;
      font-style: italic;
      font-size: 10pt;
    }

    .page-break { page-break-before: always; }
  </style>
</head>
<body>

  {# ── 1. Portada ────────────────────────────────────────────────────────── #}
  <div class="portada">
    <img class="logo" src="{{ logo_path }}" alt="Zanovix" />
    <h1>Diagnóstico AI Readiness — Sesión 1</h1>
    {% if company_name %}
    <p class="company-name">{{ company_name }}</p>
    {% endif %}
    <p class="fecha">{{ fecha }}</p>
  </div>

  {# ── 2. Resumen ejecutivo ───────────────────────────────────────────────── #}
  {% if synthesis.summary %}
  <div class="seccion">
    <h2>Resumen ejecutivo</h2>
    <p>{{ synthesis.summary }}</p>
  </div>
  {% endif %}

  {# ── 3. Hallazgos clave ────────────────────────────────────────────────── #}
  {% if synthesis.key_insights %}
  <div class="seccion">
    <h2>Hallazgos clave</h2>
    <ul>
      {% for insight in synthesis.key_insights %}
      <li>{{ insight }}</li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  {# ── 4. Recomendaciones ────────────────────────────────────────────────── #}
  {% if synthesis.recommendations %}
  <div class="seccion">
    <h2>Recomendaciones</h2>
    {% for rec in synthesis.recommendations %}
    <div class="rec-card">
      <p class="rec-text">{{ rec.text }}</p>
      <div class="rec-badges">
        {% if rec.impact %}
        <span class="badge badge-impacto-{{ rec.impact }}">Impacto: {{ rec.impact | capitalize }}</span>
        {% endif %}
        {% if rec.effort %}
        <span class="badge badge-esfuerzo-{{ rec.effort }}">Esfuerzo: {{ rec.effort | capitalize }}</span>
        {% endif %}
        {% if rec.related_service and rec.related_service in catalog_by_key %}
        <span class="badge badge-servicio">{{ catalog_by_key[rec.related_service].nombre }}</span>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {# ── 5. Roadmap 30/60/90 ───────────────────────────────────────────────── #}
  {% if synthesis.roadmap %}
  <div class="seccion">
    <h2>Hoja de ruta</h2>
    <div class="roadmap-grid">
      <div class="roadmap-col">
        <h3>30 días</h3>
        {% if synthesis.roadmap.d30 %}
        <ul>
          {% for item in synthesis.roadmap.d30 %}
          <li>{{ item }}</li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="placeholder-text">Sin elementos definidos.</p>
        {% endif %}
      </div>
      <div class="roadmap-col">
        <h3>60 días</h3>
        {% if synthesis.roadmap.d60 %}
        <ul>
          {% for item in synthesis.roadmap.d60 %}
          <li>{{ item }}</li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="placeholder-text">Sin elementos definidos.</p>
        {% endif %}
      </div>
      <div class="roadmap-col">
        <h3>90 días</h3>
        {% if synthesis.roadmap.d90 %}
        <ul>
          {% for item in synthesis.roadmap.d90 %}
          <li>{{ item }}</li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="placeholder-text">Sin elementos definidos.</p>
        {% endif %}
      </div>
    </div>
  </div>
  {% endif %}

  {# ── 6. Próximos pasos ─────────────────────────────────────────────────── #}
  {% if synthesis.next_steps %}
  <div class="seccion">
    <h2>Próximos pasos</h2>
    <ol>
      {% for step in synthesis.next_steps %}
      <li>{{ step }}</li>
      {% endfor %}
    </ol>
  </div>
  {% endif %}

  {# ── 7. Catálogo de servicios Zanovix (footer) ─────────────────────────── #}
  <div class="catalogo">
    <h2>Servicios Zanovix</h2>
    {% for svc in catalog %}
    <div class="servicio-item">
      <div class="servicio-nombre">{{ svc.nombre }}</div>
      <div class="servicio-desc">{{ svc.descripcion }}</div>
    </div>
    {% endfor %}
  </div>

</body>
</html>
