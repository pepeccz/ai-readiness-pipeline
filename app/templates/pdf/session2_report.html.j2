<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>AI Readiness Assessment — Sesión 2 · {{ session.company_name }}</title>
  <style>
    /* ─────────────────────────────────────────────────────────────────────
       PALETA (identical to session1_report for brand consistency)
       Primary  navy   #1E2A44
       Accent   ochre  #E8A33D
       Teal     accent #0D9488
       Alert    red    #B23A48
       Body     #2A2F3A
       Mute     #6B7280
       Bg-soft  #F8F9FB
       Bg-card  #FFFFFF
       Border   #E5E7EB
       ───────────────────────────────────────────────────────────────────── */
    :root {
      --primary: #1E2A44;
      --primary-2: #2C3958;
      --accent: #E8A33D;
      --teal: #0D9488;
      --teal-soft: #CCFBF1;
      --alert: #B23A48;
      --text: #2A2F3A;
      --mute: #6B7280;
      --bg-soft: #F8F9FB;
      --bg-card: #FFFFFF;
      --border: #E5E7EB;
    }

    /* ── Page setup ──────────────────────────────────────────────────────── */
    @page {
      size: A4;
      margin: 2.2cm 2cm 2cm 2cm;

      @top-left {
        content: element(runHeaderL);
      }
      @top-right {
        content: element(runHeaderR);
      }
      @bottom-left {
        content: "AI Readiness Assessment · Sesión 2";
        font-family: Helvetica, Arial, sans-serif;
        font-size: 8pt;
        color: #6B7280;
      }
      @bottom-center {
        content: "Documento confidencial";
        font-family: Helvetica, Arial, sans-serif;
        font-size: 8pt;
        color: #6B7280;
      }
      @bottom-right {
        content: counter(page) " / " counter(pages);
        font-family: Helvetica, Arial, sans-serif;
        font-size: 8pt;
        color: #6B7280;
      }
    }

    @page :first {
      margin: 0;
      @top-left { content: none; }
      @top-right { content: none; }
      @bottom-left { content: none; }
      @bottom-center { content: none; }
      @bottom-right { content: none; }
    }

    .run-header-l {
      position: running(runHeaderL);
    }
    .run-header-l img {
      height: 16px;
      vertical-align: middle;
    }

    .run-header-r {
      position: running(runHeaderR);
      font-family: Helvetica, Arial, sans-serif;
      font-size: 8pt;
      color: #6B7280;
      text-align: right;
    }

    /* ── Base typography ────────────────────────────────────────────────── */
    html, body {
      margin: 0;
      padding: 0;
    }
    body {
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-size: 10.5pt;
      color: var(--text);
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
      orphans: 4;
      widows: 4;
    }

    p { margin: 0 0 0.45cm; orphans: 4; widows: 4; }

    h1, h2, h3, h4 { font-family: Georgia, "Times New Roman", serif; }

    /* ── BORRADOR watermark ─────────────────────────────────────────────── */
    .borrador-watermark {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) rotate(-45deg);
      font-family: Helvetica, Arial, sans-serif;
      font-size: 80pt;
      font-weight: 900;
      color: rgba(220, 0, 0, 0.12);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      pointer-events: none;
      z-index: 9999;
      white-space: nowrap;
    }

    /* ── COVER ───────────────────────────────────────────────────────────── */
    .cover {
      page-break-after: always;
      height: 297mm;
      width: 210mm;
      box-sizing: border-box;
      padding: 2.5cm 2.2cm 2cm;
      background: linear-gradient(180deg, #1E2A44 0%, #2C3958 60%, #1E2A44 100%);
      color: white;
      position: relative;
    }

    .cover-logo {
      position: absolute;
      top: 1.8cm;
      right: 2.2cm;
    }
    .cover-logo img {
      height: 42px;
    }

    .cover-eyebrow {
      margin-top: 4.5cm;
      font-family: Helvetica, Arial, sans-serif;
      font-size: 9.5pt;
      font-weight: 700;
      letter-spacing: 0.18em;
      color: var(--accent);
      text-transform: uppercase;
    }

    .cover h1 {
      font-family: Georgia, serif;
      font-size: 36pt;
      font-weight: 700;
      letter-spacing: -0.015em;
      line-height: 1.05;
      margin: 0.4cm 0 0.5cm;
      max-width: 14cm;
      color: white;
    }

    .cover-subtitle {
      font-style: italic;
      font-size: 12pt;
      font-weight: 300;
      max-width: 13cm;
      color: rgba(255,255,255,0.78);
      margin: 0 0 1.2cm;
      line-height: 1.5;
    }

    /* ── Cover score block ─────────────────────────────────────────────── */
    .cover-score-row {
      display: table;
      width: 100%;
      border-top: 1px solid rgba(255,255,255,0.25);
      border-bottom: 1px solid rgba(255,255,255,0.25);
      padding: 0.5cm 0;
      margin-bottom: 0.6cm;
    }
    .cover-score-cell {
      display: table-cell;
      vertical-align: middle;
      padding-right: 1.5cm;
    }
    .cover-score-cell-wide {
      display: table-cell;
      vertical-align: middle;
      width: 60%;
    }
    .cover-score-label {
      font-family: Helvetica, Arial, sans-serif;
      font-size: 8pt;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.55);
      margin-bottom: 0.1cm;
    }
    .cover-score-value {
      font-family: Georgia, serif;
      font-size: 28pt;
      font-weight: 700;
      color: var(--accent);
      line-height: 1;
    }
    .cover-score-pct {
      font-family: Helvetica, Arial, sans-serif;
      font-size: 12pt;
      color: rgba(255,255,255,0.7);
      margin-left: 0.2cm;
    }
    .cover-level-badge {
      display: inline-block;
      font-family: Helvetica, Arial, sans-serif;
      font-size: 11pt;
      font-weight: 700;
      padding: 0.2cm 0.5cm;
      border-radius: 4px;
      margin-top: 0.15cm;
    }
    .cover-risk-badge {
      display: inline-block;
      font-family: Helvetica, Arial, sans-serif;
      font-size: 10pt;
      font-weight: 700;
      padding: 0.18cm 0.45cm;
      border-radius: 4px;
      margin-top: 0.15cm;
    }

    /* CMMI level badge colours */
    .cmmi-0 { background: #FEE2E2; color: #991B1B; }
    .cmmi-1 { background: #FEF3C7; color: #92400E; }
    .cmmi-2 { background: #FEF9C3; color: #713F12; }
    .cmmi-3 { background: #DCFCE7; color: #166534; }
    .cmmi-4 { background: #DBEAFE; color: #1E40AF; }

    /* Risk profile badge colours */
    .risk-low      { background: #DCFCE7; color: #166534; }
    .risk-medium   { background: #FEF9C3; color: #713F12; }
    .risk-high     { background: #FEF3C7; color: #92400E; }
    .risk-critical { background: #FEE2E2; color: #991B1B; }

    .cover-meta {
      border-top: 1px solid rgba(255,255,255,0.22);
      padding-top: 0.5cm;
      max-width: 14cm;
      display: table;
      width: 100%;
    }
    .cover-meta-row { display: table-row; }
    .cover-meta-label {
      display: table-cell;
      width: 4.5cm;
      font-family: Helvetica, Arial, sans-serif;
      font-size: 8.5pt;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.55);
      padding: 0.15cm 0;
      vertical-align: top;
    }
    .cover-meta-value {
      display: table-cell;
      font-family: Helvetica, Arial, sans-serif;
      font-size: 10.5pt;
      color: white;
      padding: 0.15cm 0;
    }

    .cover-footer {
      position: absolute;
      bottom: 1.6cm;
      left: 2.2cm;
      right: 2.2cm;
      font-family: Helvetica, Arial, sans-serif;
      font-size: 8.5pt;
      color: rgba(255,255,255,0.55);
      display: table;
      width: calc(100% - 4.4cm);
    }
    .cover-footer-l { display: table-cell; }
    .cover-footer-r { display: table-cell; text-align: right; }

    /* ── Section structure ───────────────────────────────────────────────── */
    .section {
      margin-bottom: 1.1cm;
    }
    .section-num {
      display: block;
      font-family: Helvetica, Arial, sans-serif;
      font-size: 9pt;
      font-weight: 700;
      letter-spacing: 0.18em;
      color: var(--teal);
      text-transform: uppercase;
      margin-bottom: 0.15cm;
    }
    h2 {
      font-size: 22pt;
      font-weight: 700;
      color: var(--primary);
      margin: 0 0 0.55cm;
      letter-spacing: -0.01em;
      line-height: 1.15;
      page-break-after: avoid;
    }
    .section-num { page-break-after: avoid; }
    .section { page-break-inside: auto; }
    h2::after {
      content: "";
      display: block;
      width: 1.8cm;
      height: 3px;
      background: var(--accent);
      margin-top: 0.25cm;
    }
    h3 {
      font-family: Helvetica, Arial, sans-serif;
      font-size: 11pt;
      font-weight: 700;
      color: var(--primary);
      margin: 0.6cm 0 0.25cm;
      letter-spacing: 0.02em;
    }

    /* ── Scorecard table ─────────────────────────────────────────────────── */
    .scorecard-table {
      width: 100%;
      border-collapse: collapse;
      margin: 0.3cm 0 0.6cm;
      font-size: 10pt;
    }
    .scorecard-table th {
      background: var(--primary);
      color: white;
      font-family: Helvetica, Arial, sans-serif;
      font-size: 8.5pt;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 0.3cm 0.4cm;
      text-align: left;
      font-weight: 700;
    }
    .scorecard-table td {
      padding: 0.28cm 0.4cm;
      vertical-align: middle;
      border-bottom: 1px solid var(--border);
    }
    .scorecard-table tr:last-child td {
      border-bottom: none;
    }
    .scorecard-table tr:nth-child(even) td {
      background: var(--bg-soft);
    }
    .scorecard-block-title {
      font-weight: 600;
      color: var(--primary);
    }
    .scorecard-score {
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-weight: 700;
      color: var(--text);
      white-space: nowrap;
    }
    .scorecard-level-badge {
      display: inline-block;
      font-family: Helvetica, Arial, sans-serif;
      font-size: 8pt;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      padding: 3px 8px;
      border-radius: 3px;
    }
    .scorecard-pending {
      font-family: Helvetica, Arial, sans-serif;
      font-size: 8.5pt;
      font-style: italic;
      color: var(--mute);
      background: #F3F4F6;
      border: 1px solid var(--border);
      padding: 3px 8px;
      border-radius: 3px;
      display: inline-block;
    }

    /* ── Block narrative section ────────────────────────────────────────── */
    .block-narrative {
      border-left: 3px solid var(--accent);
      padding: 0.3cm 0 0.3cm 0.5cm;
      margin-bottom: 0.5cm;
      page-break-inside: avoid;
    }
    .block-narrative-title {
      font-family: Helvetica, Arial, sans-serif;
      font-size: 10.5pt;
      font-weight: 700;
      color: var(--primary);
      margin-bottom: 0.15cm;
    }
    .block-narrative-level {
      margin-bottom: 0.2cm;
    }
    .block-narrative-text {
      font-size: 10pt;
      color: var(--text);
      line-height: 1.55;
    }
    .block-narrative-pending {
      font-size: 10pt;
      color: var(--mute);
      font-style: italic;
      padding: 0.2cm 0.4cm;
      background: #F9FAFB;
      border: 1px dashed var(--border);
      border-radius: 3px;
    }

    /* ── Risk narrative ──────────────────────────────────────────────────── */
    .risk-narrative-block {
      background: var(--bg-soft);
      border: 1px solid var(--border);
      border-left: 4px solid var(--alert);
      padding: 0.5cm 0.7cm;
      margin-bottom: 0.6cm;
      page-break-inside: avoid;
    }

    /* ── Recommendations ─────────────────────────────────────────────────── */
    .recs {
      counter-reset: recs;
    }
    .rec-card {
      counter-increment: recs;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 0.5cm 0.6cm 0.5cm 1.7cm;
      margin-bottom: 0.4cm;
      position: relative;
      page-break-inside: avoid;
    }
    .rec-card::before {
      content: counter(recs, decimal-leading-zero);
      position: absolute;
      left: 0.5cm;
      top: 0.5cm;
      font-family: Georgia, serif;
      font-size: 14pt;
      font-weight: 700;
      color: var(--teal);
    }
    .rec-text {
      font-size: 10.5pt;
      line-height: 1.5;
      color: var(--text);
      margin: 0 0 0.3cm;
      font-weight: 500;
    }
    .rec-meta {
      display: table;
      width: 100%;
      border-top: 1px dashed var(--border);
      padding-top: 0.25cm;
      margin-top: 0.15cm;
    }
    .rec-meta-badges { display: table-cell; vertical-align: middle; width: 48%; }
    .rec-meta-svc { display: table-cell; vertical-align: middle; text-align: right; width: 52%; padding-left: 0.3cm; }
    .rec-meta-svc .svc-tag-label { display: block; margin-bottom: 0.08cm; margin-right: 0; font-size: 7.5pt; }
    .rec-meta-svc .svc-tag {
      display: block;
      line-height: 1.25;
      font-size: 9pt;
      hyphens: auto;
      word-break: normal;
    }

    .badge {
      font-family: Helvetica, Arial, sans-serif;
      font-size: 8pt;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      padding: 3px 8px;
      border-radius: 3px;
      display: inline-block;
      margin-right: 4px;
    }
    .badge-impact-alto   { background: #FEE2E2; color: #991B1B; }
    .badge-impact-medio  { background: #FEF3C7; color: #92400E; }
    .badge-impact-bajo   { background: #D1FAE5; color: #065F46; }
    .badge-effort-alto   { background: #F3F4F6; color: #374151; border: 1px solid #D1D5DB; }
    .badge-effort-medio  { background: #F3F4F6; color: #374151; border: 1px solid #D1D5DB; }
    .badge-effort-bajo   { background: #F3F4F6; color: #374151; border: 1px solid #D1D5DB; }

    .svc-tag {
      font-family: Helvetica, Arial, sans-serif;
      font-size: 8.5pt;
      color: var(--primary);
      font-weight: 600;
    }
    .svc-tag-label {
      font-size: 7.5pt;
      color: var(--mute);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-right: 4px;
    }
    .svc-tag-extern {
      color: var(--mute);
      font-style: italic;
    }

    /* ── Roadmap timeline ───────────────────────────────────────────────── */
    .timeline {
      display: table;
      width: 100%;
      border-collapse: collapse;
      margin: 0.3cm 0 0.4cm;
      page-break-inside: avoid;
    }
    .timeline-col {
      display: table-cell;
      width: 33.33%;
      vertical-align: top;
      padding: 0 0.25cm;
      page-break-inside: avoid;
    }
    .timeline-head {
      color: white;
      padding: 0.32cm 0.4cm;
      border-radius: 3px 3px 0 0;
      text-align: center;
    }
    .timeline-head-30 { background: var(--teal); }
    .timeline-head-60 { background: var(--accent); }
    .timeline-head-90 { background: var(--primary); }
    .timeline-head-num {
      font-family: Georgia, serif;
      font-size: 22pt;
      font-weight: 700;
      color: white;
      line-height: 1;
    }
    .timeline-head-60 .timeline-head-num { color: var(--primary); }
    .timeline-head-label {
      font-family: Helvetica, Arial, sans-serif;
      font-size: 8.5pt;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: white;
      margin-top: 0.1cm;
    }
    .timeline-head-60 .timeline-head-label { color: var(--primary); opacity: 0.7; }
    .timeline-body {
      background: var(--bg-soft);
      border: 1px solid var(--border);
      border-top: none;
      padding: 0.35cm 0.4cm;
      border-radius: 0 0 3px 3px;
      min-height: 4cm;
    }
    .timeline-body ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .timeline-body li {
      font-size: 9.5pt;
      line-height: 1.45;
      padding: 0.12cm 0;
      border-bottom: 1px dotted var(--border);
      color: var(--text);
    }
    .timeline-body li:last-child { border-bottom: none; }
    .timeline-body li::before {
      content: "▸";
      color: var(--teal);
      margin-right: 0.18cm;
      font-weight: 700;
    }
    .timeline-empty {
      font-style: italic;
      font-size: 9pt;
      color: var(--mute);
    }

    /* ── Next steps ─────────────────────────────────────────────────────── */
    .next-steps {
      counter-reset: nextsteps;
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .next-steps li {
      counter-increment: nextsteps;
      position: relative;
      padding: 0.3cm 0.3cm 0.3cm 1.4cm;
      border-bottom: 1px solid var(--border);
      font-size: 10.5pt;
      page-break-inside: avoid;
    }
    .next-steps li:last-child { border-bottom: none; }
    .next-steps li::before {
      content: counter(nextsteps);
      position: absolute;
      left: 0;
      top: 0.32cm;
      width: 1cm;
      height: 1cm;
      background: var(--teal);
      color: white;
      font-family: Helvetica, Arial, sans-serif;
      font-size: 11pt;
      font-weight: 700;
      text-align: center;
      line-height: 1cm;
      border-radius: 50%;
    }

    /* ── Closing block ──────────────────────────────────────────────────── */
    .closing {
      margin-top: 1.2cm;
      padding-top: 0.7cm;
      border-top: 2px solid var(--primary);
      page-break-inside: avoid;
    }
    .closing-title {
      font-family: Georgia, serif;
      font-size: 14pt;
      font-weight: 700;
      color: var(--primary);
      margin: 0 0 0.3cm;
    }
    .closing p {
      font-size: 10pt;
      color: var(--text);
      margin: 0 0 0.3cm;
    }
    .closing-contact {
      font-size: 10.5pt;
      color: var(--primary);
    }
    .closing-contact strong { color: var(--teal); }
  </style>
</head>
<body>

  {# ── BORRADOR watermark (only when draft=True) ────────────────────────── #}
  {% if draft %}
  <div class="borrador-watermark">BORRADOR</div>
  {% endif %}

  {# ── Running header (pages 2+) ────────────────────────────────────────── #}
  <div class="run-header-l">
    {% if logo_path %}<img src="{{ logo_path }}" alt="Zanovix">{% endif %}
  </div>
  <div class="run-header-r">
    {{ session.company_name }} &nbsp;·&nbsp; {{ session.generation_date }}
  </div>

  {# ═══════════════════════════════════════════════════════════════════════
     PORTADA
     ═══════════════════════════════════════════════════════════════════════ #}
  <div class="cover">
    <div class="cover-logo">
      {% if logo_white_path %}<img src="{{ logo_white_path }}" alt="Zanovix">{% endif %}
    </div>

    {% if draft %}
    <div style="position:absolute;top:1.5cm;left:2.2cm;background:#B23A48;color:white;font-family:Helvetica,Arial,sans-serif;font-size:9pt;font-weight:700;padding:4px 12px;border-radius:3px;letter-spacing:0.12em;text-transform:uppercase;">
      BORRADOR — no entregar al cliente
    </div>
    {% endif %}

    <div class="cover-eyebrow">AI Readiness Assessment · Informe Final</div>
    <h1>{{ session.company_name }}</h1>
    <p class="cover-subtitle">
      Scorecard de madurez IA, narrativa por dimensión,
      recomendaciones priorizadas por brecha y hoja de ruta 30/60/90.
    </p>

    {# ── Composite score + risk profile block ───────────────────────────── #}
    <div class="cover-score-row">
      <div class="cover-score-cell">
        <div class="cover-score-label">Score compuesto</div>
        <div class="cover-score-value">
          {{ (session.composite_score * 100) | round(0) | int }}<span class="cover-score-pct">%</span>
        </div>
        <div>
          <span class="cover-level-badge cmmi-{{ session.composite_level }}">
            {{ session.composite_level_name }}
          </span>
        </div>
      </div>
      <div class="cover-score-cell-wide">
        <div class="cover-score-label">Perfil de riesgo</div>
        <div>
          <span class="cover-risk-badge risk-{{ session.risk_profile }}">
            {% if session.risk_profile == 'low' %}Riesgo Bajo
            {% elif session.risk_profile == 'medium' %}Riesgo Medio
            {% elif session.risk_profile == 'high' %}Riesgo Alto
            {% elif session.risk_profile == 'critical' %}Riesgo Crítico
            {% else %}{{ session.risk_profile }}
            {% endif %}
          </span>
        </div>
      </div>
    </div>

    <div class="cover-meta">
      {% if session.contact_name %}
      <div class="cover-meta-row">
        <div class="cover-meta-label">Contacto</div>
        <div class="cover-meta-value">{{ session.contact_name }}{% if session.contact_email %} — {{ session.contact_email }}{% endif %}</div>
      </div>
      {% endif %}
      {% if session.sector %}
      <div class="cover-meta-row">
        <div class="cover-meta-label">Sector</div>
        <div class="cover-meta-value">{{ session.sector }}</div>
      </div>
      {% endif %}
      <div class="cover-meta-row">
        <div class="cover-meta-label">Fecha de emisión</div>
        <div class="cover-meta-value">{{ session.generation_date }}</div>
      </div>
      {% if session.reference_id %}
      <div class="cover-meta-row">
        <div class="cover-meta-label">Referencia</div>
        <div class="cover-meta-value">AIR-{{ session.reference_id }}</div>
      </div>
      {% endif %}
    </div>

    <div class="cover-footer">
      <div class="cover-footer-l">Documento confidencial — uso exclusivo de {{ session.company_name }}</div>
      <div class="cover-footer-r">Tu hoja de ruta para adoptar IA con criterio</div>
    </div>
  </div>

  {# ═══════════════════════════════════════════════════════════════════════
     01 · Scorecard por dimensión (REQ-19)
     Precedes all narrative sections — required by spec.
     ═══════════════════════════════════════════════════════════════════════ #}
  <div class="section">
    <span class="section-num">01 · Scorecard de madurez IA</span>
    <h2>Puntuación por dimensión</h2>
    <p style="font-size:10pt;color:var(--mute);margin:0 0 0.4cm;">
      Cada dimensión se puntúa de 0 a 100 % y se clasifica en uno de los cinco
      niveles CMMI: Inicial · Emergente · Establecido · Avanzado · Optimizado.
    </p>

    <table class="scorecard-table">
      <thead>
        <tr>
          <th style="width:35%">Dimensión</th>
          <th style="width:18%">Puntuación</th>
          <th style="width:22%">Nivel CMMI</th>
          <th style="width:25%">Estado</th>
        </tr>
      </thead>
      <tbody>
        {% for block in session.per_block %}
        <tr>
          <td class="scorecard-block-title">{{ block.block_title }}</td>
          <td class="scorecard-score">{{ (block.score * 100) | round(0) | int }} %</td>
          <td>
            <span class="scorecard-level-badge cmmi-{{ block.level }}">{{ block.level_name }}</span>
          </td>
          <td>
            {% if block.block_id in session.insufficient_block_ids %}
            <span class="scorecard-pending">Datos pendientes — completar en Sesión 2</span>
            {% else %}
            <span style="font-size:9pt;color:var(--teal);">✓ Evaluado</span>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    {# Summary row — composite #}
    <div style="display:table;width:100%;border-top:2px solid var(--primary);padding-top:0.3cm;margin-top:0.1cm;">
      <div style="display:table-cell;font-weight:700;color:var(--primary);font-size:10.5pt;">
        Score compuesto (nivel mínimo)
      </div>
      <div style="display:table-cell;text-align:right;white-space:nowrap;">
        <strong>{{ (session.composite_score * 100) | round(0) | int }} %</strong>
        &nbsp;
        <span class="scorecard-level-badge cmmi-{{ session.composite_level }}">{{ session.composite_level_name }}</span>
        &nbsp;
        <span class="cover-risk-badge risk-{{ session.risk_profile }}" style="font-size:8pt;padding:2px 7px;">
          {% if session.risk_profile == 'low' %}Riesgo Bajo
          {% elif session.risk_profile == 'medium' %}Riesgo Medio
          {% elif session.risk_profile == 'high' %}Riesgo Alto
          {% elif session.risk_profile == 'critical' %}Riesgo Crítico
          {% else %}{{ session.risk_profile }}
          {% endif %}
        </span>
      </div>
    </div>
  </div>

  {# ═══════════════════════════════════════════════════════════════════════
     02 · Narrativa por bloque (REQ-19)
     ═══════════════════════════════════════════════════════════════════════ #}
  <div class="section">
    <span class="section-num">02 · Análisis por dimensión</span>
    <h2>Hallazgos y brechas por área</h2>

    {% for block in session.per_block %}
    <div class="block-narrative">
      <div class="block-narrative-title">{{ block.block_title }}</div>
      <div class="block-narrative-level">
        <span class="scorecard-level-badge cmmi-{{ block.level }}">{{ block.level_name }}</span>
        &nbsp;
        <span style="font-size:9pt;color:var(--mute);">{{ (block.score * 100) | round(0) | int }} %</span>
      </div>
      {% if block.block_id in session.insufficient_block_ids %}
      <div class="block-narrative-pending">
        Datos pendientes — completar en Sesión 2
      </div>
      {% else %}
      <div class="block-narrative-text">{{ block.indicators_synthesized }}</div>
      {% endif %}
    </div>
    {% endfor %}
  </div>

  {# ═══════════════════════════════════════════════════════════════════════
     03 · Recomendaciones ordenadas por brecha (REQ-20)
     Sorted in the Python layer by target_gap_size descending.
     ═══════════════════════════════════════════════════════════════════════ #}
  {% if session.recommendations %}
  <div class="section">
    <span class="section-num">03 · Recomendaciones</span>
    <h2>Acciones priorizadas por brecha</h2>
    <p style="font-size:9.5pt;color:var(--mute);margin:0 0 0.4cm;">
      Ordenadas de mayor a menor brecha: la dimensión con menor nivel CMMI aparece primero.
    </p>

    <div class="recs">
      {% for rec in session.recommendations %}
      <div class="rec-card">
        <p class="rec-text">{{ rec.text }}</p>
        <div class="rec-meta">
          <div class="rec-meta-badges">
            {% if rec.impact %}<span class="badge badge-impact-{{ rec.impact }}">Impacto {{ rec.impact }}</span>{% endif %}
            {% if rec.effort %}<span class="badge badge-effort-{{ rec.effort }}">Esfuerzo {{ rec.effort }}</span>{% endif %}
          </div>
          <div class="rec-meta-svc">
            {% if rec.related_service and rec.related_service != 'otro' and rec.related_service in catalog_by_key %}
              <span class="svc-tag-label">Servicio Zanovix</span>
              <span class="svc-tag">{{ catalog_by_key[rec.related_service].nombre }}</span>
            {% elif rec.related_service == 'otro' %}
              <span class="svc-tag-label">Acción externa</span>
              <span class="svc-tag svc-tag-extern">{{ rec.custom_service_label or 'Acción externa al alcance Zanovix' }}</span>
            {% endif %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {# ═══════════════════════════════════════════════════════════════════════
     04 · Hoja de ruta 30/60/90 (REQ-21)
     ═══════════════════════════════════════════════════════════════════════ #}
  {% if session.roadmap %}
  <div class="section">
    <span class="section-num">04 · Hoja de ruta</span>
    <h2>30 · 60 · 90 días</h2>

    <div class="timeline">
      <div class="timeline-col">
        <div class="timeline-head timeline-head-30">
          <div class="timeline-head-num">30</div>
          <div class="timeline-head-label">días</div>
        </div>
        <div class="timeline-body">
          {% if session.roadmap.d30 %}
          <ul>{% for item in session.roadmap.d30 %}<li>{{ item }}</li>{% endfor %}</ul>
          {% else %}<p class="timeline-empty">Sin acciones definidas.</p>{% endif %}
        </div>
      </div>
      <div class="timeline-col">
        <div class="timeline-head timeline-head-60">
          <div class="timeline-head-num">60</div>
          <div class="timeline-head-label">días</div>
        </div>
        <div class="timeline-body">
          {% if session.roadmap.d60 %}
          <ul>{% for item in session.roadmap.d60 %}<li>{{ item }}</li>{% endfor %}</ul>
          {% else %}<p class="timeline-empty">Sin acciones definidas.</p>{% endif %}
        </div>
      </div>
      <div class="timeline-col">
        <div class="timeline-head timeline-head-90">
          <div class="timeline-head-num">90</div>
          <div class="timeline-head-label">días</div>
        </div>
        <div class="timeline-body">
          {% if session.roadmap.d90 %}
          <ul>{% for item in session.roadmap.d90 %}<li>{{ item }}</li>{% endfor %}</ul>
          {% else %}<p class="timeline-empty">Sin acciones definidas.</p>{% endif %}
        </div>
      </div>
    </div>
  </div>
  {% endif %}

  {# ═══════════════════════════════════════════════════════════════════════
     05 · Próximos pasos
     ═══════════════════════════════════════════════════════════════════════ #}
  {% if session.next_steps %}
  <div class="section">
    <span class="section-num">05 · Próximos pasos</span>
    <h2>Por dónde continuar</h2>
    <ol class="next-steps">
      {% for step in session.next_steps %}<li>{{ step }}</li>{% endfor %}
    </ol>
  </div>
  {% endif %}

  {# ═══════════════════════════════════════════════════════════════════════
     Cierre + contacto
     ═══════════════════════════════════════════════════════════════════════ #}
  <div class="closing">
    <p class="closing-title">¿Quieres profundizar en los resultados?</p>
    <p>
      Este informe es la base para coordinar los próximos pasos.
      Si quieres ajustar prioridades o planificar la implementación,
      contacta con nosotros:
    </p>
    <p class="closing-contact">
      <strong>{{ consultor_name }}</strong> &nbsp;·&nbsp; {{ consultor_email }} &nbsp;·&nbsp; zanovix.com
    </p>
  </div>

</body>
</html>
